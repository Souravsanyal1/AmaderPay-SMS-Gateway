{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/docs", "destination": "/docs.html" },
    { "source": "/merchant", "destination": "/merchant.html" },
    { "source": "/login", "destination": "/merchant.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/checkout", "destination": "/checkout.html" }
  ]
}
