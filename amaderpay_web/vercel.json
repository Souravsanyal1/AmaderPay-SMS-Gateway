{
  "version": 2,
  "cleanUrls": false,
  "trailingSlash": false,
  "routes": [
    { "src": "^/api/v1/checkout/create$", "dest": "/api/checkout.php" },
    { "src": "^/api/v1/checkout/verify/(.*)$", "dest": "/api/checkout.php?session_id=$1" },
    { "src": "^/api/v1/webhook/(.*)$", "dest": "/api/webhook.php?action=$1" },
    { "src": "^/api/v1/auth/(.*)$", "dest": "/api/auth.php?action=$1" },
    { "src": "^/api/v1/(.*)$", "dest": "/api/$1.php" },
    { "src": "^/docs(\\.html)?$", "dest": "/docs.html" },
    { "src": "^/merchant(\\.html)?$", "dest": "/merchant.html" },
    { "src": "^/login$", "dest": "/merchant.html" },
    { "src": "^/privacy(\\.html)?$", "dest": "/privacy.html" },
    { "src": "^/checkout(\\.html)?$", "dest": "/checkout.html" },
    { "src": "^/download$", "dest": "/index.html" },
    { "src": "^/nexorapay-release\\.apk$", "dest": "/nexorapay-release.apk", "headers": { "Content-Type": "application/vnd.android.package-archive", "Content-Disposition": "attachment; filename=\"NexoraPay-v1.0.0.apk\"" } },
    { "src": "^/amaderpay-release\\.apk$", "dest": "/amaderpay-release.apk", "headers": { "Content-Type": "application/vnd.android.package-archive", "Content-Disposition": "attachment; filename=\"NexoraPay-v1.0.0.apk\"" } },
    { "handle": "filesystem" },
    { "src": "^/.*$", "dest": "/index.html" }
  ]
}
