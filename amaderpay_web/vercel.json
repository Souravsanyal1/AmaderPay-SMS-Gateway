{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/docs", "destination": "/docs.html" },
    { "source": "/merchant", "destination": "/merchant.html" },
    { "source": "/login", "destination": "/merchant.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/checkout", "destination": "/checkout.html" },
    { "source": "/download", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/amaderpay-release.apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"AmaderPay-v1.0.0.apk\"" }
      ]
    }
  ]
}
