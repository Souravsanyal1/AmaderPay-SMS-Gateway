{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/v1/checkout/create", "destination": "/api/checkout.php" },
    { "source": "/api/v1/checkout/verify/:session_id*", "destination": "/api/checkout.php?session_id=:session_id*" },
    { "source": "/api/v1/webhook/:action*", "destination": "/api/webhook.php?action=:action*" },
    { "source": "/api/v1/auth/:action*", "destination": "/api/auth.php?action=:action*" },
    { "source": "/api/v1/:path*", "destination": "/api/:path*.php" },
    { "source": "/docs", "destination": "/docs.html" },
    { "source": "/merchant", "destination": "/merchant.html" },
    { "source": "/login", "destination": "/merchant.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/checkout", "destination": "/checkout.html" },
    { "source": "/download", "destination": "/index.html" },
    { "source": "/:path((?!api/|assets/|.*\\.apk|.*\\.html|.*\\.css|.*\\.js|.*\\.png|.*\\.jpg|.*\\.ico).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/nexorapay-release.apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"NexoraPay-v1.0.0.apk\"" }
      ]
    },
    {
      "source": "/amaderpay-release.apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"NexoraPay-v1.0.0.apk\"" }
      ]
    }
  ]
}
